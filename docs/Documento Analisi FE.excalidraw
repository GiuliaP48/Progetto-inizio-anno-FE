    },
    {
      "id": "u9S5oC-CEjPeeXcZzkDqt",
      "type": "text",
      "x": 5264.288981495743,
      "y": 5983.556713720187,
      "width": 800,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbX",
      "roundness": null,
      "seed": 1206991327,
      "version": 623,
      "versionNonce": 123270868,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791142893307,
      "created": 1790969057021,
      "link": null,
      "locked": false,
      "text": "Il primo è sempre il colore del calendario poi\ncolori standard in questo ordine:\n- #f97366: Corallo,\n- #f5b83d: Giallo,\n- #34b37e: Verde,\n- #2fa6c4: Azzurro,\n- #5170ff: Blu,\n- #8b5cf6: Viola,\n- #cb6ce6: Lilla,\n- #ff66c4: Rosa\nL'ultimo pallino è quello arcobaleno per far\nscegliere il colore all'utente (si apre la griglia\nper scegliere il colore)",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Il primo è sempre il colore del calendario poi colori standard in questo ordine:\n- #f97366: Corallo,\n- #f5b83d: Giallo,\n- #34b37e: Verde,\n- #2fa6c4: Azzurro,\n- #5170ff: Blu,\n- #8b5cf6: Viola,\n- #cb6ce6: Lilla,\n- #ff66c4: Rosa\nL'ultimo pallino è quello arcobaleno per far scegliere il colore all'utente (si apre la griglia per scegliere il colore)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
