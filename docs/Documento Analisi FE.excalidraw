    {
      "id": "OQVSz437KdQ4ZXj9iZmiU",
      "type": "text",
      "x": 5479.564234791642,
      "y": 5148.858990331515,
      "width": 624.3883514404297,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bba",
      "roundness": null,
      "seed": 1890235775,
      "version": 391,
      "versionNonce": 318699348,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791142893307,
      "created": 1790969470460,
      "link": null,
      "locked": false,
      "text": "da spuntare se si vuole mettere un\nevento senza data per tutto il\ngiorno. Se spuntato spariscono\nanche gli orari di Inizio e Fine, e si\nimposta il giorno ed inizio e fine\ncoincidono",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "da spuntare se si vuole mettere un evento senza data per tutto il giorno. Se spuntato spariscono anche gli orari di Inizio e Fine, e si imposta il giorno ed inizio e fine coincidono",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
