      "isDeleted": false,
      "boundElements": [],
      "updated": 1791142893308,
      "created": 1790977893509,
      "link": null,
      "locked": false,
      "text": "da spuntare se si vuole mettere un\nevento senza data per tutto il\ngiorno. Se spuntato spariscono\nanche gli orari di Inizio e Fine, e si\nimposta il giorno ed inizio e fine\ncoincidono",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "da spuntare se si vuole mettere un evento senza data per tutto il giorno. Se spuntato spariscono anche gli orari di Inizio e Fine, e si imposta il giorno ed inizio e fine coincidono",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
